# Copy to .env and point at your backends.
# Emulator: http://10.0.2.2:8000 (Android) works without this file.
# Physical phone: use your PC's LAN IP, e.g. http://192.168.1.13:8000
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.13:8000

# Supabase (dashboard → Connect → Expo React Native). Leave empty for offline demo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Local AI: no client key needed. The app calls the backend (/api/ai/*),
# which proxies to Ollama on the dev PC.
# Backend env (PowerShell): $env:OLLAMA_MODEL="llama3.1:8b"; $env:OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Setup: ollama pull llama3.1:8b; ollama serve
