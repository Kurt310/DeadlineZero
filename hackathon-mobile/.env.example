# Copy to .env and point at your backends.
# Emulator: http://10.0.2.2:8000 (Android) works without this file.
# Physical phone: use your PC's LAN IP, e.g. http://192.168.1.13:8000
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.13:8000

# Supabase (dashboard → Connect → Expo React Native). Leave empty for offline demo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Gemini (Google AI Studio → Get API key). Leave empty to hide AI features behind a setup hint.
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional: EXPO_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
